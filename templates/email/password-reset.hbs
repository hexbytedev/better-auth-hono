{{#> layout}}
	{{#*inline "body"}}
		<p>{{#if name}}Hello {{name}},{{else}}Hello,{{/if}}</p>
		<p>We received a request to reset the password for your account. You can set a new password by clicking the button below.</p>
		<table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-top: 10px; margin-bottom: 10px;">
			<tr>
				<td align="left">
					<a href="{{url}}" style="background-color: #2d5a2d; color: #ffffff; padding: 16px 32px; font-size: 16px; font-weight: 600; display: inline-block; border: 1px solid #2d5a2d;">Reset Password</a>
				</td>
			</tr>
		</table>
		<p style="font-size: 14px; color: #71717a;">This link will expire in {{expiresIn}}.</p>
	{{/inline}}
	{{#*inline "footer"}}
		If you didn't request a password reset, you can safely ignore this email. Your current password will remain unchanged.
	{{/inline}}
{{/layout}}
