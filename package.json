{
  "name": "hono-better-auth",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir=dist --target=bun --minify --sourcemap=external",
    "lint": "biome check --write src",
    "lint:check": "biome check src",
    "format": "biome format --write src",
    "generate": "bunx drizzle-kit generate",
    "push": "bunx drizzle-kit push",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.9",
    "@better-auth/passkey": "^1.6.9",
    "@hono/zod-validator": "^0.7.6",
    "@sentry/bun": "^10.51.0",
    "better-auth": "^1.6.9",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.16",
    "pg": "^8.20.0",
    "resend": "^6.12.2",
    "uuid": "^14.0.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "^1.3.13",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7"
  }
}
