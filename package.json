{
  "name": "hono-better-auth",
  "version": "0.0.14",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir=dist --target=bun --minify --sourcemap=external",
    "test": "bun test",
    "lint": "biome check --write src",
    "lint:check": "biome check src",
    "lint:migrate": "biome migrate --write",
    "format": "biome format --write src",
    "generate": "bunx drizzle-kit generate",
    "migrate": "bunx drizzle-kit migrate",
    "push": "bunx drizzle-kit push",
    "studio": "bunx drizzle-kit studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@better-auth/expo": "^1.7.12",
    "@better-auth/passkey": "^1.7.12",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.14",
    "@sentry/bun": "^11.9.0",
    "better-auth": "^1.7.12",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "handlebars": "^4.7.10",
    "hono": "^4.13.14",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.1",
    "resend": "^6.34.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7"
  },
  "overrides": {
    "zod": "^4.6.7",
    "esbuild": "^0.25.12"
  }
}
