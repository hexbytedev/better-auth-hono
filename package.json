{
  "name": "hono-better-auth",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir=dist --target=bun --minify --sourcemap=external",
    "lint": "biome check --write src",
    "lint:check": "biome check src",
    "format": "biome format --write src",
    "generate": "bunx drizzle-kit generate",
    "push": "bunx drizzle-kit push",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.5.2",
    "@better-auth/passkey": "^1.5.2",
    "@hono/zod-validator": "^0.7.6",
    "@sentry/bun": "^10.42.0",
    "better-auth": "^1.5.2",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.4",
    "pg": "^8.19.0",
    "resend": "^6.9.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/bun": "^1.3.10",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "husky": "^9.1.7"
  }
}
