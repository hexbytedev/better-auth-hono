{
  "name": "hono-better-auth",
  "version": "0.0.12",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir=dist --target=bun --minify --sourcemap=external",
    "test": "bun test",
    "lint": "biome check --write src",
    "lint:check": "biome check src",
    "format": "biome format --write src",
    "generate": "bunx drizzle-kit generate",
    "migrate": "bunx drizzle-kit migrate",
    "push": "bunx drizzle-kit push",
    "studio": "bunx drizzle-kit studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@better-auth/expo": "^1.7.5",
    "@better-auth/passkey": "^1.7.5",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.3",
    "@sentry/bun": "^10.75.0",
    "better-auth": "^1.7.5",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.0",
    "resend": "^6.28.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7"
  }
}
