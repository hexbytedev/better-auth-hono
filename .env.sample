# ==============================================
# API SECURITY (BASIC AUTH)
# ==============================================
# The username required to access protected routes (e.g. /api/users/*)
API_AUTH_USER=admin_user

# The password required to access protected routes
# You can use complex characters here.
API_AUTH_PASSWORD=secure_password_123

# ===========================================
# CORS CONFIGURATION (Optional)
# Leave empty to use sensible defaults
# ===========================================

# Allowed request headers (comma-separated)
# Default: Content-Type, Authorization, Cookie, X-API-Key
CORS_ALLOWED_HEADERS=

# Allowed HTTP methods (comma-separated)
# Default: POST, GET, OPTIONS, PUT, DELETE, PATCH
CORS_ALLOWED_METHODS=

# Headers exposed to the browser (comma-separated)
# Default: Content-Length, Set-Cookie, Set-Auth-Token
CORS_EXPOSE_HEADERS=

# How long browsers cache preflight responses (seconds, 0-86400)
# Default: 600 (10 minutes)
CORS_MAX_AGE=

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Port number for the server (1-65535)
# Default: 8558
APP_PORT=8558

# Host binding address
# Default: undefined (server decides)
APP_HOST=

# ===========================================
# BETTER AUTH CORE CONFIGURATION
# ===========================================


# Server URL where Better Auth is hosted
# This is the base URL for your authentication server
# Development: http://localhost:8558
# Production: https://api.yourdomain.com
# IMPORTANT: Must match your actual server URL for OAuth callbacks to work
BETTER_AUTH_SERVER_URL=http://localhost:8558

# Secret key for encryption, signing, and hashing
# Generate with: openssl rand -base64 32
# CRITICAL: Keep this secret and use a strong random value in production
# https://www.better-auth.com/docs/reference/options
BETTER_AUTH_SECRET=

# ===========================================
# CLIENT & CORS CONFIGURATION
# ===========================================

# Client-side application URL (frontend)
# Used for:
# - CORS configuration (allowed origins)
# - WebAuthn passkey setup
# - JWT audience (aud) claim validation
# - OAuth redirect URIs
# Development: http://localhost:3000
# Production: https://app.yourdomain.com
CLIENT_URL=http://localhost:3000

# CORS allowed origins (comma-separated list)
# Include all domains that will make requests to your auth server
# Supports wildcards: https://*.yourdomain.com
# https://www.better-auth.com/docs/reference/options (trustedOrigins)
# Example: http://localhost:3000, http://localhost:3001, https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000, http://localhost:3001

# ===========================================
# CROSS-SUBDOMAIN COOKIE CONFIGURATION
# ===========================================

# Enable cross-subdomain cookie sharing
# Set to true if you need to share auth cookies across subdomains
# Example: auth.yourdomain.com and app.yourdomain.com
CROSS_SUBDOMAIN_COOKIES_ENABLED=false

# Domain for cross-subdomain cookies (without protocol)
# Use your root domain with a leading dot for subdomains
# Examples:
# - .yourdomain.com (for *.yourdomain.com subdomains)
# - .localhost (for *.localhost subdomains in development)
# Leave empty if CROSS_SUBDOMAIN_COOKIES_ENABLED=false
CROSS_SUBDOMAIN_COOKIES_DOMAIN=

# ===========================================
# COOKIE SECURITY SETTINGS
# ===========================================

# Cookie SameSite attribute
# Options: "strict", "lax", "none"
# - "strict": Most secure, cookies only sent with same-site requests
# - "lax": Good balance, allows some cross-site usage
# - "none": Required for cross-site/iframe usage (requires secure=true)
COOKIE_SAME_SITE=lax

# Force secure cookies (HTTPS only)
# Set to true to always require HTTPS for cookies
# Automatically enabled in production when using HTTPS
COOKIE_SECURE=false

# Enable HTTP-only cookies (recommended for security)
# Prevents JavaScript access to auth cookies
COOKIE_HTTP_ONLY=true

# Enable partitioned cookies (Chrome's privacy feature)
# Helps with third-party cookie restrictions
# Set to true if using cross-site authentication
COOKIE_PARTITIONED=false

# PostgreSQL database connection URL
DATABASE_URL="postgres://user:password@IP:Port/db-name"

# ===========================================
# SEPARATE EMAIL SERVICE SETTINGS
# ===========================================

# Email service api connection
EMAIL_SERVICE_API=https://youremailservice.com

# Email Service Basic auth
EMAIL_SERVICE_USERNAME=basic_auth_username
EMAIL_SERVICE_PASSWORD=email_basic_auth_pass

# ===========================================
# SOCIAL AUTHENTICATION (OAuth)
# ===========================================

# Google OAuth Configuration
# Get credentials from: https://console.developers.google.com/
# Required scopes: openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth Configuration  
# Get credentials from: https://github.com/settings/applications/new
# Required scopes: read:user, user:email
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===========================================
# WEBAUTHN/PASSKEY CONFIGURATION
# ===========================================

# Relying Party ID (domain without protocol/port)
# For development: localhost
# For production: your-domain.com (without https://)
# Must match the domain where passkeys will be used
BETTER_AUTH_RP_ID=localhost

# Relying Party Name (human-readable app name)
# This appears in passkey prompts to users
# Example: "My Awesome App"
BETTER_AUTH_RP_NAME=your-app-name

# JWT expiration time
JWT_EXPIRATION_TIME=1h

# ===========================================
# FRAUD CHECKING (hexbyte's internal tool)
# ===========================================
# Fraud check API URL for email validation
# Used to validate emails and domains during sign up
# Set to your fraud detection service endpoint
FRAUD_CHECK_API_URL=https://fraudcheckapi.hexbyte.dev

# ===========================================
# SENTRY CONFIGURATION
# ===========================================
# Sentry DSN for error tracking
SENTRY_DSN=

# Sentry traces sample rate (0.0 to 1.0, leave empty to disable tracing)
SENTRY_TRACES_SAMPLE_RATE=1.0

# Send default PII (personally identifiable information) to Sentry (true/false)
SENTRY_SEND_DEFAULT_PII=false

# Docker image
TZ=Europe/Berlin

# Enable telemetry (1), Disable telemetry (0)
# https://www.better-auth.com/docs/reference/telemetry
BETTER_AUTH_TELEMETRY=0
