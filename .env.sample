# ==============================================
# INTERNAL API SECURITY (SERVER-TO-SERVER) - OPTIONAL
# ==============================================
# If both API_AUTH_USER and API_AUTH_PASSWORD are provided,
# Basic Auth will be enabled for /api/users/* endpoints.
# If either is missing, these endpoints will be disabled (503 Service Unavailable).
#
# The username is required to access protected routes (e.g. /api/users/*).
# Leave empty to disable Basic Auth protected routes.
API_AUTH_USER=
#
# The password is required to access protected routes.
# You can use complex characters here.
# Leave empty to disable Basic Auth protected routes.
API_AUTH_PASSWORD=
#
# IP Address Whitelist (OPTIONAL Second Layer, requires Basic Auth to be enabled)
# Comma-separated list of allowed CLIENT IP addresses (e.g., your microservices)
# that can access /api/users/* endpoints.
# If Basic Auth is enabled AND this list is populated, the client must pass BOTH:
#   1. Valid Basic Auth credentials
#   2. Their IP address must be in this list
# Example: 10.0.0.50, 203.0.113.10
# Leave empty to disable IP whitelist (only Basic Auth will be required if configured).
API_ALLOWED_IPS=

# ===========================================
# TRUSTED PROXIES (REQUIRED IF BEHIND NGINX)
# ===========================================
#
# Comma-separated list of IP addresses or CIDR ranges of your reverse proxies (e.g., Nginx).
# The app will ONLY trust X-Real-IP / X-Forwarded-For headers if the request
# originates from one of these IPs. This prevents attackers from spoofing their IP address.
#
# Examples:
# - 127.0.0.1 (If Nginx and the app run on the same host)
# - 172.16.0.0/12 (If Nginx is a reverse proxy container in Docker)
#
# Leave empty if running without a reverse proxy (app exposed directly to the internet).
TRUSTED_PROXIES=

# ===========================================
# APPLICATION SETTINGS
# ===========================================
#
# Port number for the server (1-65535)
# Default: 8558
APP_PORT=8558
#
# Host binding address
# Default: undefined (server decides)
APP_HOST=0.0.0.0
#
# Expo app scheme for deep link redirects (Expo integration)
# Used by Better Auth's expo() plugin to build trusted origins
# for OAuth/deep-link callbacks back to the mobile app.
# Must match the "scheme" in your Expo app's app.json.
# Example: myapp
APP_SCHEME=

# ===========================================
# BETTER AUTH CORE CONFIGURATION
# ===========================================
#
# Server URL where Better Auth is hosted
# This is the base URL for your authentication server.
# Development: http://localhost:8558
# Production: https://api.yourdomain.com
# IMPORTANT: Must match your actual server URL for OAuth callbacks to work.
BETTER_AUTH_SERVER_URL=http://localhost:8558
#
# Secret key for encryption, signing, and hashing
# Generate with: openssl rand -base64 32
# CRITICAL: Keep this secret and use a strong random value in production.
# https://www.better-auth.com/docs/reference/options
BETTER_AUTH_SECRET=

# ===========================================
# CLIENT & CORS CONFIGURATION
# ===========================================
#
# Client-side application URL (frontend)
# Used for:
# - CORS configuration (allowed origins)
# - WebAuthn passkey setup
# - JWT audience (aud) claim validation
# - OAuth redirect URIs
# Development: http://localhost:3000
# Production: https://app.yourdomain.com
CLIENT_URL=http://localhost:3000
#
# CORS allowed origins (comma-separated list)
# Include all domains that will make requests to your auth server.
# You must specify exact origins for security reasons.
# https://www.better-auth.com/docs/reference/options (trustedOrigins)
# Example: http://localhost:3000, http://localhost:3001, https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000, http://localhost:3001

# ===========================================
# CROSS-SUBDOMAIN COOKIE CONFIGURATION
# ===========================================
#
# Enable cross-subdomain cookie sharing
# Set to true if you need to share auth cookies across subdomains.
# Example: auth.yourdomain.com and app.yourdomain.com
CROSS_SUBDOMAIN_COOKIES_ENABLED=false
#
# Domain for cross-subdomain cookies (without protocol)
# Use your root domain with a leading dot for subdomains.
# Examples:
# - .yourdomain.com (for *.yourdomain.com subdomains)
# - .localhost (for *.localhost subdomains in development)
# Leave empty if CROSS_SUBDOMAIN_COOKIES_ENABLED=false.
CROSS_SUBDOMAIN_COOKIES_DOMAIN=

# ===========================================
# COOKIE SECURITY SETTINGS
# ===========================================
#
# Cookie SameSite attribute
# Options: "strict", "lax", "none"
# - "strict": Most secure, cookies only sent with same-site requests
# - "lax": Good balance, allows some cross-site usage
# - "none": Required for cross-site/iframe usage (requires COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax
#
# Force secure cookies (HTTPS only)
# Set to true to always require HTTPS for cookies.
# Automatically enabled in production when using HTTPS.
COOKIE_SECURE=false
#
# Enable HTTP-only cookies (recommended for security)
# Prevents JavaScript access to auth cookies.
COOKIE_HTTP_ONLY=true
#
# Enable partitioned cookies (Chrome's privacy feature)
# Helps with third-party cookie restrictions.
# Set to true if using cross-site authentication.
COOKIE_PARTITIONED=false

# ===========================================
# DATABASE
# ===========================================
#
# PostgreSQL database connection URL
DATABASE_URL="postgres://user:password@IP:Port/db-name"
#
# Maximum number of clients in the connection pool (optional)
# Default: 10
DB_POOL_MAX=10
#
# Milliseconds to wait for a free client before failing a query (optional).
# Prevents queries from hanging forever when Postgres is unreachable.
# Default: 5000
DB_CONNECTION_TIMEOUT_MS=5000

# ===========================================
# EMAIL SERVICE SETTINGS (RESEND)
# ===========================================
#
# Resend API Key (required)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=
#
# From email address (required, must be verified in Resend)
# Example: no-reply@yourdomain.com
EMAIL_FROM=
#
# Company name (required, displayed in email templates)
# Example: Your Company Name
COMPANY_NAME=
#
# Primary brand color (required, hex code WITHOUT # symbol)
# Example: 007bff or 2d5a2d
# The # will be added automatically in the code.
PRIMARY_COLOR=2d5a2d
#
# Token expiration time in seconds (required)
# Used for both email verification and password reset tokens.
# Examples: 3600 (1 hour), 7200 (2 hours), 1800 (30 minutes)
# Default: 3600 (1 hour)
TOKEN_EXPIRATION_SECONDS=3600

# ===========================================
# EMAIL/PASSWORD AUTHENTICATION - OPTIONAL
# ===========================================
#
# Enable or disable email/password authentication
# Set to "false" to disable email/password sign-up and sign-in.
# Default: true (enabled)
EMAIL_PASSWORD_ENABLED=true

# ===========================================
# EMAIL OTP AUTHENTICATION - OPTIONAL
# ===========================================
#
# Enable or disable email OTP authentication
# Set to "true" to enable sign-in, verification, and password reset via OTP codes.
# Default: false (disabled)
EMAIL_OTP_ENABLED=false
#
# OTP expiration time in seconds (only used if EMAIL_OTP_ENABLED=true)
# Default: 300 (5 minutes)
OTP_EXPIRATION_SECONDS=300

# ===========================================
# SOCIAL AUTHENTICATION (OAuth) - OPTIONAL
# ===========================================
# Social providers are automatically enabled when credentials are provided.
# Leave empty to disable a specific provider.
#
# Google OAuth Configuration (OPTIONAL)
# Get credentials from: https://console.developers.google.com/
# Required scopes: openid, email, profile
# Leave empty to disable Google authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# GitHub OAuth Configuration (OPTIONAL)
# Get credentials from: https://github.com/settings/applications/new
# Required scopes: read:user, user:email
# Leave empty to disable GitHub authentication.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===========================================
# WEBAUTHN/PASSKEY CONFIGURATION
# ===========================================
#
# Relying Party ID (domain without protocol/port)
# For development: localhost
# For production: your-client-application-domain.com (without https://)
# Must match the domain where passkeys will be used.
BETTER_AUTH_RP_ID=localhost
#
# Relying Party Name (human-readable app name)
# This appears in passkey prompts to users.
# Example: "My Awesome App"
BETTER_AUTH_RP_NAME=your-app-name

# ===========================================
# JWT
# ===========================================
#
# JWT expiration time
JWT_EXPIRATION_TIME=1h

# ===========================================
# FRAUD CHECKING (DeGhost API) - OPTIONAL
# ===========================================
#
# DeGhost is a fraud detection service that screens registrations.
# When enabled (this URL is set), the sign-up hook checks two things:
#   1. Email address (hard gate). The remote must explicitly allow it (HTTP 200),
#      otherwise the signup is BLOCKED. This is FAIL-CLOSED: any non-200 status,
#      or an unreachable/erroring API, blocks the signup (the error is logged to
#      Sentry).
#   2. IP address (secondary signal). Checked for proxy/VPN usage and threat
#      indicators; blocks only on an explicit threat verdict. Other IP-check
#      errors do not block.
#
# API docs: https://deghost.hexbyte.dev
#
# Set to your DeGhost API endpoint.
# Leave empty to disable fraud checking entirely.
FRAUD_CHECK_API_URL=https://deghostapi.hexbyte.dev
#
# Block sign-ups from public / free email providers (gmail.com, outlook.com, ...)
# using the fraud API's `public_domain` verdict. Useful for B2B apps that only
# want organization email addresses.
#   - Requires FRAUD_CHECK_API_URL (the verdict comes from that response).
#   - Only affects email/password and email-OTP sign-up; OAuth (Google/GitHub)
#     sign-ups are NOT affected.
#   - Rejected requests get HTTP 400 with code "PUBLIC_DOMAIN_NOT_ALLOWED".
# Set to "true" to enable. Default: false (public domains allowed).
BLOCK_PUBLIC_DOMAIN_SIGNUP=false

# ===========================================
# SENTRY CONFIGURATION
# ===========================================
#
# Sentry DSN for error tracking
# Leave empty to disable Sentry logging.
SENTRY_DSN=
#
# Sentry traces sample rate (0.0 to 1.0, leave empty to disable tracing)
SENTRY_TRACES_SAMPLE_RATE=1.0
#
# Send default PII (personally identifiable information) to Sentry (true/false)
SENTRY_SEND_DEFAULT_PII=false

# ===========================================
# GENERAL
# ===========================================
#
# Docker image
TZ=Europe/Berlin
#
# Enable telemetry (1), Disable telemetry (0)
# https://www.better-auth.com/docs/reference/telemetry
BETTER_AUTH_TELEMETRY=0
